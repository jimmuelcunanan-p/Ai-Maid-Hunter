DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=30&sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
SESSION_SECRET="replace-with-at-least-32-random-characters"
PORT=3001
APP_ORIGIN="http://localhost:5173"
SEARCH_PROVIDER="tavily"
TAVILY_API_KEY=
TAVILY_BASE_URL="https://api.tavily.com/search"
# Set AI_PROVIDER=groq and provide a key for live GroqCloud analysis.
# The deterministic mock analyzer is used when Groq is not configured.
AI_PROVIDER="mock"
GROQ_API_KEY=
GROQ_MODEL="openai/gpt-oss-20b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
# Optional future OpenAI-compatible adapter
OPENAI_API_KEY=
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL=
